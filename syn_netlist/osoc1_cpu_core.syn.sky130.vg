  wire [4:0] rs2;
  wire [31:0] rs2_val;
  input rst_ni;
  wire rst_ni;
  wire [1:0] s1_sel;
  wire s2_sel;
  wire s_flag;
  wire z_flag;
  alu u_alu (
    .alu_op_i(alu_op),
    .carry_o(carry_flag),
    .ovfl_o(ov_flag),
    .res_o(alu_res),
    .s_o(s_flag),
    .src1_i(alu_a),
    .src2_i(alu_b),
    .z_o(z_flag)
