    .funct7_i(f7),
    .imm_src_o(imm_src),
    .is_cond_branch_o(is_br),
    .is_jal_o(is_jal),
    .is_jalr_o(is_jalr),
    .opcode_i(op),
    .regfile_we_o(rf_we)
  );
  decoder u_decoder (
    .f3_o(f3),
    .f7_o(f7),
    .imm_o(imm),
    .instr_i(instr_i),
    .op_o(op),
    .rd_o(rd),
    .rs1_o(rs1),
    .rs2_o(rs2)
  );
  lau u_lau (
    .adrs_0_i(alu_res[0]),
    .adrs_1_i(alu_res[1]),
    .aligned_data_o(lau_res),
    .funct3_i(f3),
    .mem_data_i(dmem_rdata_i)
  );
  next_pc_logic u_next_pc_logic (
    .alu_res_i(alu_res),
    .imm_i(imm),
    .pc_curr_i(pc_curr),
    .pc_next_o(pc_next),
