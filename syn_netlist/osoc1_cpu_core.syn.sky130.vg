    .pc_src_i(pc_src)
  );
  pc_plus_4 u_pc_plus_4 (
    .pc_curr_i(pc_curr),
    .pc_plus_4_o(pc_plus_4)
  );
  pc_reg u_pc_reg (
    .clk_i(clk_i),
    .pc_d_i(pc_next),
    .pc_q_o(pc_curr),
    .rst_ni(rst_ni)
  );
  reg_file u_reg_file (
    .clk_i(clk_i),
    .rd1_o(rs1_val),
    .rd2_o(rs2_val),
    .rd_i(rd),
    .rs1_i(rs1),
    .rs2_i(rs2),
    .wd_i(rf_wd),
    .we_i(rf_we)
