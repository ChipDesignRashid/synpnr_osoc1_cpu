    .rs2_val_i(rs2_val),
    .s1_sel_i(s1_sel),
    .s2_sel_i(s2_sel)
  );
  bcu u_bcu (
    .f3_i(f3),
    .flags_i({ z_flag, s_flag, ov_flag, carry_flag }),
    .is_cond_branch_i(is_br),
    .is_jal_i(is_jal),
    .is_jalr_i(is_jalr),
    .pc_src_o(pc_src)
  );
  ctrl u_ctrl (
    .alu_ctrl_o(alu_op),
    .alu_src1_ctrl_o(s1_sel),
    .alu_src2_ctrl_o(s2_sel),
    .dataMem2Reg_o(d2r),
